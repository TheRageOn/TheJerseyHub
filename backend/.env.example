# Server Configuration
PORT=5001

# Database Configuration (MongoDB Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/TheJerseyHub?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/TheJerseyHub?retryWrites=true&w=majority
MONGODB_USERNAME=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=7d

# Root Admin Credentials
ADMIN_NAME=Root Admin
ADMIN_EMAIL=admin@thejerseyhub.com
ADMIN_PASSWORD=your_secure_admin_password